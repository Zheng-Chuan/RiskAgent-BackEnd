# Database Configuration
MYSQL_ROOT_PASSWORD=change_me
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=riskagent
MYSQL_USER=admin
MYSQL_PASSWORD=change_me

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# LLM（OpenRouter + DeepSeek）
# 本项目默认使用 OpenRouter 作为 LLM 网关, 模型为 deepseek/deepseek-v4-pro
# 请把真实密钥写入本地 .env 不要提交到 git
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro

# MCP Server Configuration
MCP_SERVER_NAME=RiskAgent BackEnd
MCP_SERVER_VERSION=0.1.0

# Memory Configuration
WORKING_MEMORY_BACKEND=memory
WORKING_MEMORY_MAX_LEN=2000
WORKING_MEMORY_TTL_S=86400
REDIS_URL=redis://localhost:6379/0
LONG_TERM_MEMORY_DB_URL=
MEMORY_SQLITE_PATH=

# Postgres Example
POSTGRES_DB=riskagent_memory
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
