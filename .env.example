# Database Configuration
# 密码为本地开发默认值 (与 docker-compose / deploy/k8s/values.yaml 一致), 生产环境必须替换
MYSQL_ROOT_PASSWORD=XiPL15NFRvcw6PecN9vK-A
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=riskagent
MYSQL_USER=admin
MYSQL_PASSWORD=34ktfzUrRLI7L5xyrP19_A

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# LLM（OpenRouter + DeepSeek）
# 本项目默认使用 OpenRouter 作为 LLM 网关, 模型为 deepseek/deepseek-v4-pro
# 请把真实密钥写入本地 .env 不要提交到 git
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro
# RFC-005 需求二: embedding 模型 (经 OpenRouter 调用, 1536 维)
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Skill Configuration
SKILL_QUERY_REWRITE_ENABLED=true
SKILL_QUERY_REWRITE_TIMEOUT=3.0
SKILL_QUERY_REWRITE_CACHE_SIZE=256
CHROMA_SKILLS_COLLECTION=riskagent-skills
SKILL_HYBRID_VECTOR_WEIGHT=0.7

# MCP Server Configuration
MCP_SERVER_NAME=RiskAgent BackEnd
MCP_SERVER_VERSION=0.1.0
MCP_TRANSPORT=streamable-http
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Chroma Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Memory Configuration
SEMANTIC_MEMORY_ENABLED=true
MEMORY_MAX_LEN=2000
MEMORY_TTL_S=86400

# Auth Configuration (fail-closed)
# REST API / metrics / MCP 工具的 Bearer Token, 生产环境必须设置
RISKAGENT_API_TOKEN=
# 未设置 Token 时是否放行请求; 仅限本地开发/测试, 生产环境不要开启
RISKAGENT_ALLOW_UNAUTHENTICATED=1

# HITL Configuration
# 副作用操作是否自动审批; 安全默认关闭, 仅本地演示/测试时设为 true
HITL_AUTO_APPROVE=false

# LLM Cost Model (per 1K tokens, USD) - leave empty to use built-in pricing table
LLM_COST_PROMPT_PER_1K=
LLM_COST_COMPLETION_PER_1K=
