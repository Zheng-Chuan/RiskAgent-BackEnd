# Database Configuration
# 密码为本地开发默认值 (与 docker-compose / deploy/k8s/values.yaml 一致), 生产环境必须替换
MYSQL_ROOT_PASSWORD=XiPL15NFRvcw6PecN9vK-A
MYSQL_HOST=localhost
# docker-compose 将 MySQL 宿主端口映射为 3307 (容器内仍为 3306)
MYSQL_PORT=3307
MYSQL_DATABASE=riskagent
MYSQL_USER=admin
MYSQL_PASSWORD=34ktfzUrRLI7L5xyrP19_A

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# LLM（DeepSeek 官方 API）
# 本项目默认使用 DeepSeek 官方 API, 模型为 deepseek-v4-flash
# 请把真实密钥写入本地 .env 不要提交到 git
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# RFC-005 需求二: embedding 模型
# DeepSeek 官方无 embeddings 端点, embedding 需独立指向支持 embedding 的供应商
# 示例: 硅基流动 SiliconFlow (无 text-embedding-3-small, 推荐 BAAI/bge-m3, 1024 维)
LLM_EMBEDDING_MODEL=BAAI/bge-m3
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_API_KEY=

# Skill Configuration
SKILL_QUERY_REWRITE_ENABLED=true
SKILL_QUERY_REWRITE_TIMEOUT=3.0
SKILL_QUERY_REWRITE_CACHE_SIZE=256
CHROMA_SKILLS_COLLECTION=riskagent-skills
SKILL_HYBRID_VECTOR_WEIGHT=0.7

# MCP Server Configuration
MCP_TRANSPORT=streamable-http
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000

# Redis Configuration (密码为本地开发默认值, 与 docker-compose / deploy/k8s/values.yaml 一致)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=9s-R5At6itSHSWex6L8how
REDIS_URL=redis://:9s-R5At6itSHSWex6L8how@localhost:6379/0

# Chroma Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Memory Configuration
SEMANTIC_MEMORY_ENABLED=true
MEMORY_MAX_LEN=2000
MEMORY_TTL_S=86400

# Auth Configuration (fail-closed)
# REST API / metrics / MCP 工具的 Bearer Token, 生产环境必须设置
RISKAGENT_API_TOKEN=
# 未设置 Token 时是否放行请求; 仅限本地开发/测试, 生产环境不要开启
RISKAGENT_ALLOW_UNAUTHENTICATED=1

# HITL Configuration
# 副作用操作是否自动审批; 安全默认关闭, 仅本地演示/测试时设为 true
HITL_AUTO_APPROVE=false

# LLM Cost Model (per 1K tokens, USD) - leave empty to use built-in pricing table
LLM_COST_PROMPT_PER_1K=
LLM_COST_COMPLETION_PER_1K=

# ----------------------------------------------------------------------
# RFC-007 规划项预告（Accepted, Not Implemented）
# 以下 flag 均为 RFC-007 规划中的 feature flag, 当前代码中尚不存在,
# 实施后启用. 此处仅以注释态预告, 不新增任何生效变量.
# 详见 docs/decisions/RFC-007-governance-trust-production-readiness.md
# ----------------------------------------------------------------------
# --- P0 治理五项 ---
# HITL_APPROVAL_MODE=tiered_shadow            # 分级审批: off / tiered_shadow / tiered_enforce
# INDEPENDENT_VALIDATOR_ENABLED=false         # 独立验证器总开关
# INDEPENDENT_VALIDATOR_MODE=shadow           # 独立验证器: off / shadow / enforce
# ROLLBACK_JOURNAL_ENABLED=false              # rollback journal 记录开关
# ROLLBACK_EXECUTE_ENABLED=false              # 补偿命令执行开关 (与 journal 分离)
# INJECTION_GUARD_ENABLED=false               # 注入防御总开关
# INJECTION_GUARD_MODE=shadow                 # 注入防御: off / shadow / enforce
# --- P1 能力增强 ---
# CHECKPOINT_PERSISTENCE_ENABLED=false        # checkpoint 持久化 (MySQL run_checkpoint 表)
# MEMORY_CONFLICT_RESOLUTION_ENABLED=false    # 记忆写入冲突消解 (supersede)
# SKILL_VALIDATE_BEFORE_STORE=false           # Voyager 式 skill quarantine: eval 通过才转 active
# REFLEXION_ENABLED=false                     # Reflexion 式失败反思回灌
# --- P2 生态扩展 ---
# A2A_ENABLED=false                           # A2A 协议适配器
